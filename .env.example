# Database connection
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=github_data
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Security
# IMPORTANT: Once set, this value should never change or users won't be found by their email hash!
EMAIL_HASH_PEPPER=your_secret_pepper_key_for_email_hashing

# GitHub API
GITHUB_TOKEN=your_github_token

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL 