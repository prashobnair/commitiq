# GitHub API Token
GITHUB_TOKEN=your_github_token

# Database Connection
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production

# Security
EMAIL_HASH_PEPPER=your_email_hash_pepper

# URL Configuration
FRONTEND_URL=https://your-frontend-url.onrender.com
REACT_APP_API_URL=https://your-api-url.onrender.com/api

# Local development settings
# Uncomment these for local development and comment out the RDS settings above if needed
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=commitiq
# DB_USER=postgres
# DB_PASSWORD=postgres

# Redis settings (if needed)
# REDIS_HOST=your_redis_host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0
# REDIS_ENABLED=false